      "sourceRoles": ["official-fact", "editorial-discovery"],
      "queryTemplates": {
        "zh": "{destination} {yearMonth} 节庆 活动 官方",
        "en": "{destination} {yearMonth} festival events official",
        "local": "{destination} {yearMonth} {local:events-calendar} official"
      }
    },
    {
      "id": "local-food-structure",
      "terms": {"zh": ["地方菜", "家庭菜"], "en": ["local dishes", "home cooking"], "local": ["当地语言地方菜词", "当地语言家庭菜词"]},
