{
  "schemaVersion": "0.1.0",
  "id": "global-base",
  "name": "Global Base",
  "version": "0.1.0",
  "regions": ["global"],
  "languageStrategy": {
    "required": ["zh", "en", "destination-local"],
    "localLanguageTags": ["destination-local"]
  },
  "sources": [
    {
      "id": "unesco-world-heritage-centre",
      "name": "UNESCO World Heritage Centre",
      "url": "https://whc.unesco.org/",
      "kind": "official-institution",
      "regions": ["global"],
      "languages": ["en", "fr"],
      "roles": ["official-fact", "local-context"],
      "access": {
        "class": "A",
        "searchMethod": "公开名录与 site:whc.unesco.org + 地点正式名称",
        "loginRequired": false,
        "toolDependency": null,
        "agentAccess": "public-web",
        "fallback": ["目的地文化主管机构与遗产管理方官网"]
      },
      "factBoundary": {
        "canSupport": ["遗产身份", "官方范围", "保护背景"],
        "cannotProve": ["当天开放", "票务", "现场体验", "路线可行性"]
      },
      "lastVerified": "2026-07-31",
      "limitations": ["只覆盖列入名录的文化与自然遗产"]
    },
    {
      "id": "openstreetmap",
      "name": "OpenStreetMap",
      "url": "https://www.openstreetmap.org/",
      "kind": "map-platform",
      "regions": ["global"],
      "languages": ["multi"],
      "roles": ["spatial-search"],
      "access": {
        "class": "A",
        "searchMethod": "公开地图按正式名称、地址与附近类别搜索",
        "loginRequired": false,
        "toolDependency": null,
        "agentAccess": "public-web",
        "fallback": ["目的地官方地图或另一独立公开地图"]
      },
      "factBoundary": {
        "canSupport": ["名称", "坐标", "道路与空间关系线索"],
        "cannotProve": ["营业", "票务", "体验质量", "适合模板"]
      },
      "lastVerified": "2026-07-31",
      "limitations": ["社区维护数据的新鲜度和完整度因地区而异"]
    },
    {
      "id": "eater-city-guides",
      "name": "Eater City Guides",
      "url": "https://www.eater.com/maps",
      "kind": "local-editorial",
      "subtype": "food-drink",
      "coverageRegions": ["Eater 已设城市编辑网络"],
      "beats": ["restaurants", "bars", "food culture"],
      "regions": ["selected-global-cities"],
      "languages": ["en"],
      "roles": ["editorial-discovery", "local-context"],
      "access": {
        "class": "B",
        "searchMethod": "公开城市地图或 site:eater.com + 城市 + 主题词",
        "loginRequired": false,
        "toolDependency": null,
        "agentAccess": "conditional-public-web",
        "fallback": ["目的地具名餐饮编辑源", "经营方官网与菜单"]
      },
      "factBoundary": {
        "canSupport": ["餐饮候选", "编辑视角", "地方饮食语境"],
        "cannotProve": ["实时营业", "当前菜单", "订位成功", "交通与安全"]
      },
      "lastVerified": "2026-07-31",
      "limitations": ["仅覆盖有编辑版的城市，文章更新时间不等于商户状态"]
    }
  ],
  "queryIntents": [
    {
      "id": "date-bound-events",
