    {
      "id": "china-mct",
      "name": "中华人民共和国文化和旅游部",
      "url": "https://www.mct.gov.cn/",
      "kind": "official-institution",
      "regions": ["CN"],
      "languages": ["zh-CN"],
      "roles": ["official-fact", "local-context"],
      "access": {
        "class": "A",
        "searchMethod": "官网栏目或 site:mct.gov.cn + 城市/省份 + 活动/非遗/文旅关键词",
        "loginRequired": false,
        "toolDependency": null,
        "agentAccess": "public-web",
        "fallback": ["省市文旅局", "地方政府与活动主办方官网"]
      },
      "factBoundary": {
        "canSupport": ["国家级政策与公告", "公开文旅活动线索", "非遗与文化背景"],
        "cannotProve": ["具体商户营业", "地方活动当天执行", "现场体验"]
      },
      "lastVerified": "2026-07-31",
      "limitations": ["地方活动需回到省市主管部门或主办方复核"]
    },
    {
      "id": "amap-gui-and-web",
      "name": "高德地图 amap-gui 与公开网页",
      "url": "https://developer.amap.com/api/cli/map-cli/reference",
      "kind": "map-platform",
      "regions": ["CN"],
      "languages": ["zh-CN"],
      "roles": ["spatial-search"],
      "access": {
        "class": "B",
        "searchMethod": "先运行能力探测；配置完成后按城市关键词、锚点周边与路线方式执行 CLI，否则只用公开网页或 URI",
        "loginRequired": false,
        "toolDependency": "optional amap-gui command plus user environment credentials",
        "agentAccess": "conditional-cli-or-public-web",
        "fallback": ["高德公开网页或 URI", "另一独立公开地图并标记未完成高德路网复核"]
      },
      "factBoundary": {
        "canSupport": ["POI 名称与标识", "地址坐标", "附近候选", "实际执行后的路线结果"],
        "cannotProve": ["营业", "菜品", "体验质量", "模板匹配", "未实际执行的路线"]
      },
      "lastVerified": "2026-07-31",
      "limitations": ["CLI 是否可用取决于本地安装与用户环境配置；能力探测不等于路线已核实"]
    },
    {
      "id": "the-paper-citywalk",
      "name": "澎湃新闻·城市漫步",
      "url": "https://www.thepaper.cn/",
      "kind": "local-editorial",
      "subtype": "city-life-culture",
      "coverageRegions": ["中国大陆主要城市"],
      "beats": ["城市文化", "街区生活", "建筑与公共空间"],
      "regions": ["CN"],
      "languages": ["zh-CN"],
      "roles": ["editorial-discovery", "local-context"],
      "access": {
        "class": "B",
        "searchMethod": "公开站内页面或 site:thepaper.cn + 城市 + 城市漫步/街区/文化关键词",
        "loginRequired": false,
        "toolDependency": null,
        "agentAccess": "conditional-public-web",
        "fallback": ["具名地方文化机构内容", "城市规划馆、博物馆或街区官方资料"]
      },
      "factBoundary": {
        "canSupport": ["城市文化语境", "街区与公共空间候选", "居民用词线索"],
        "cannotProve": ["实时营业", "票务", "安全", "交通", "活动确定发生"]
      },
      "lastVerified": "2026-07-31",
      "limitations": ["全国覆盖不均，编辑报道日期不能替代当前事实"]
    }
