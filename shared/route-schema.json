{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Travel Assistant Route Schema",
  "description": "统一行程数据格式，Phase 1 产出，Phase 3 和 Phase 4 共用",
  "type": "object",
  "required": ["trip", "days"],
  "properties": {
    "trip": {
      "type": "object",
      "required": ["title", "days"],
      "properties": {
        "title": { "type": "string", "description": "行程标题" },
        "days": { "type": "integer", "description": "总天数" },
        "startDate": { "type": "string", "description": "开始日期 YYYY-MM-DD" },
        "travelers": {
          "type": "object",
          "properties": {
            "adults": { "type": "integer" },
            "children": { "type": "integer" },
            "seniors": { "type": "integer" }
          }
        },
        "transport": {
          "type": "object",
          "description": "跨城交通信息",
          "properties": {
            "outbound": {
              "type": "object",
              "properties": {
                "type": { "type": "string", "enum": ["train", "flight", "bus", "car"] },
                "number": { "type": "string", "description": "车次号或航班号" },
                "from": { "type": "string" },
                "to": { "type": "string" },
                "departTime": { "type": "string" },
                "arriveTime": { "type": "string" },
                "duration": { "type": "string" },
                "price": { "type": "number" },
                "seatClass": { "type": "string" },
                "availability": { "type": "string" },
                "bookingUrl": { "type": "string" }
              }
            },
            "return": {
              "type": "object",
              "properties": {
                "type": { "type": "string", "enum": ["train", "flight", "bus", "car"] },
                "number": { "type": "string" },
                "from": { "type": "string" },
                "to": { "type": "string" },
                "departTime": { "type": "string" },
                "arriveTime": { "type": "string" },
                "duration": { "type": "string" },
                "price": { "type": "number" },
                "seatClass": { "type": "string" },
                "availability": { "type": "string" },
                "bookingUrl": { "type": "string" }
              }
            }
          }
        },
        "hotel": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "lng": { "type": "number" },
            "lat": { "type": "number" },
            "address": { "type": "string" }
          }
        },
        "budget": {
          "type": "object",
          "properties": {
            "transport": { "type": "number" },
            "accommodation": { "type": "number" },
            "food": { "type": "number" },
            "tickets": { "type": "number" },
            "local_transport": { "type": "number" },
            "total": { "type": "number" }
          }
        }
      }
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["day", "label", "area", "locations"],
        "properties": {
          "day": { "type": "integer" },
          "label": { "type": "string", "description": "如 D1 · 道里区" },
          "date": { "type": "string" },
          "area": { "type": "string", "description": "当天主区域" },
          "color": { "type": "string", "description": "当天标记颜色" },
          "weather": {
            "type": "object",
            "properties": {
              "condition": { "type": "string" },
              "temp": { "type": "string" }
            }
          },
          "locations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type", "lng", "lat", "time"],
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string", "enum": ["food", "spot", "drink", "hotel", "transport"] },
                "lng": { "type": "number" },
                "lat": { "type": "number" },
                "time": { "type": "string", "description": "HH:MM 或 —" },
                "desc": { "type": "string" },
                "budget": { "type": "string" },
                "pay": {
                  "type": "object",
                  "properties": {
                    "cash": { "type": "number", "enum": [0, 0.5, 1] },
                    "card": { "type": "number", "enum": [0, 0.5, 1] },
                    "alipay": { "type": "number", "enum": [0, 0.5, 1] },
                    "wechat": { "type": "number", "enum": [0, 0.5, 1] }
                  }
                },
                "xhs": { "type": "string", "description": "小红书/旅拍链接" },
                "reserve": { "type": "string", "description": "预约链接" },
                "verified": { "type": "boolean", "default": false, "description": "Phase 2 是否已调研验证" },
                "amap": {
                  "type": "object",
                  "properties": {
                    "rating": { "type": "number" },
                    "tel": { "type": "string" },
                    "openHours": { "type": "string" }
                  }
                },
                "dianping": {
                  "type": "object",
                  "properties": {
                    "taste": { "type": "number" },
                    "queue": { "type": "string" },
                    "verdict": { "type": "string" },
                    "reviewCredibility": { "type": "string", "enum": ["high", "medium", "low-suspect"] }
                  }
                },
                "xhsData": {
                  "type": "object",
                  "properties": {
                    "link": { "type": "string" },
                    "verdict": { "type": "string" },
                    "negativeRatio": { "type": "number" },
                    "negativeImpact": { "type": "string", "enum": ["low", "medium", "high"] },
                    "promotionalPostsDetected": { "type": "integer" }
                  }
                }
              }
            }
          },
          "route": {
            "type": "object",
            "properties": {
              "segments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "from": { "type": "string" },
                    "to": { "type": "string" },
                    "to2": { "type": "string" },
                    "mode": { "type": "string", "enum": ["driving", "transit", "walking"] },
                    "duration": { "type": "number", "description": "分钟" },
                    "distance": { "type": "number", "description": "公里" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}